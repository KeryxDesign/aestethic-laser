# GentleTest — sta in /gentletest sul server Hostinger
ErrorDocument 404 /gentletest/404.html

# La chiave Kit e' letta solo server-side da lead.php: mai servirla via HTTP
<Files "kit_key.php">
  Require all denied
</Files>

# Registro di riserva dei lead non consegnati: dato personale, mai via HTTP
<Files "lead_fallback.log.php">
  Require all denied
</Files>

# /gentletest/prenota -> calendario SumUp Booking (302: se il cliente cambia
# sistema di prenotazione basta aggiornare questa riga, QR e link restano validi)
Redirect 302 /gentletest/prenota https://www.sumupbookings.com/gentlebeam

# Landing Search: l'URL senza barra finale (quello del canonical e degli annunci)
# risponde 200 con la pagina, senza il 301 verso la versione con la barra.
# DirectorySlash Off vale solo per questo URL: le altre cartelle restano come sono.
# Inherit: le eventuali regole della root del dominio (es. HTTPS) restano valide qui.
<If "%{REQUEST_URI} == '/gentletest/epilazione-laser-palermo'">
  DirectorySlash Off
</If>
RewriteEngine On
RewriteOptions Inherit

# Media tolti dal sito il 07/10 (F1 Davide: manca il consenso scritto delle clienti).
# Il deploy FTP non cancella i file dal server: questi 8 percorsi esatti rispondono 410 Gone.
# Un file nuovo caricato con lo stesso nome risponderebbe 410: per rimetterlo va tolta questa riga.
RewriteRule ^(images/chat-luana\.(webp|jpg)|videos/(poster-[1-3]\.jpg|testimonianza-vocale-[1-3]\.mp4))$ - [G]

# Percorsi visualizzati negli annunci (07/10): portano alla landing con un solo 301.
# Con o senza barra finale, anche da www. La query string passa intatta (gclid, utm).
RewriteRule ^(laser-palermo|prezzi|si-parte-piano)/?$ https://gentlebeam.it/gentletest/epilazione-laser-palermo/ [R=301,L]

# www.gentlebeam.it -> gentlebeam.it, su HTTPS: stesso percorso, stessa query string.
# Solo GET e HEAD: un 301 trasformerebbe la POST del modulo in GET e il lead andrebbe perso.
RewriteCond %{HTTP_HOST} ^www\.gentlebeam\.it [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^ https://gentlebeam.it%{REQUEST_URI} [R=301,L]

RewriteRule ^epilazione-laser-palermo$ /gentletest/epilazione-laser-palermo/index.html [L]

# Cache dei file statici (07/10). L'HTML non e' toccato da queste regole.
# Immagini e video: un anno. Non hanno versione nel nome, quindi un file che cambia
# cambia nome, altrimenti chi e' gia' passato tiene il vecchio fino a un anno.
# Font: un anno e immutable, non cambiano mai.
# fix.css e fix.js cambiano a ogni giro e non hanno versione: no-cache, il browser li
# ricontrolla a ogni pagina (304 se uguali), cosi' dopo un deploy non resta CSS vecchio.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

# HTML (07/10, ok Davide): no-cache, il browser ricontrolla la pagina a ogni visita (304 se uguale).
# Copre anche le cartelle servite da index.html. "always" serve per la 404 vera, che esce con stato 404.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
